__pycache__/
*.pyc
.last_deep_search.*
.plans/
.qa/
.mimocode/
.agents/
Crash.txt
test_report*.md
reports/
standalone/logs/
Temp/
.pytest_cache/
*.log
*.json.tmp

# Git commit-message temp files (used instead of inline -m quoting traps)
COMMIT_MSG_TMP*

# Deno JS engine (vendored binary ~127 MB + npm cache ~4781 files)
# Copy from web-media-parser dist/WebMediaParser/bin/ to deno/ :
#   Copy-Item "$srcBin\deno.exe" "deno\deno.exe"
#   Copy-Item -Recurse "$srcBin\deno_cache" "deno\deno_cache"
deno/

# Deno --node-modules-dir=auto artifact (recreated from vendored cache on first render call)
node_modules/

# Moli headless browser (vendored binary ~97 MB)
# Copy from the extracted release zip to moli/moli.exe:
#   Copy-Item "$src\moli.exe" "moli\moli.exe"
moli/
